/* Main Application Window */
QMainWindow {
    background-color: #0B0E11; /* Midnight Deep Charcoal */
    color: #E2E8F0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #15191E; /* Dark Obsidian */
    border-right: 1px solid #2D3139; /* Border Gray */
}

/* Sidebar Buttons */
#Sidebar QPushButton {
    background-color: transparent;
    color: #A0AABF;
    border: none;
    text-align: left;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
    border-left: 4px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #1E232B;
    color: #FFFFFF;
}

#Sidebar QPushButton:checked {
    background-color: #1E232B;
    color: #6366F1; /* Vibrant Indigo */
    border-left: 4px solid #6366F1;
    font-weight: bold;
}

/* Main Content Area */
#ContentArea {
    background-color: #0B0E11;
}

/* Rounded Cards */
.QFrame#Card {
    background-color: #15191E;
    border-radius: 12px;
    border: 1px solid #2D3139;
    padding: 20px;
}

/* Typography */
QLabel {
    color: #E2E8F0;
    font-family: 'Segoe UI', sans-serif;
}

#HeaderTitle {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
}

#SubHeader {
    font-size: 14px;
    color: #A0AABF;
}

/* Inputs and Forms */
QLineEdit {
    background-color: #1E232B;
    border: 1px solid #2D3139;
    border-radius: 6px;
    padding: 10px;
    color: #FFFFFF;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #6366F1;
    background-color: #15191E;
}

/* Primary Action Buttons */
QPushButton.PrimaryAction {
    background-color: #6366F1;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton.PrimaryAction:hover {
    background-color: #4F46E5;
}

QPushButton.PrimaryAction:pressed {
    background-color: #4338CA;
}

/* WhatsApp Buy Button */
QPushButton#WhatsAppBtn {
    background-color: #25D366;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 15px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#WhatsAppBtn:hover {
    background-color: #1DA851;
}
/* General Button Styling for Toolbar */
QPushButton {
    border-radius: 12px;
    font-weight: bold;
    padding: 8px 12px;
    background-color: #2D3139;
    color: #E2E8F0;
    border: none;
}

QPushButton:hover {
    background-color: #374151;
}

/* Dropdown Menus */
QMenu {
    background-color: #1E232B;
    color: #E2E8F0;
    border: 1px solid #2D3139;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px;
    border-radius: 4px;
    font-weight: 500;
}

QMenu::item:selected {
    background-color: #374151;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #2D3139;
    margin: 5px 10px;
}

/* Additional Rules for Tables and Dialogs in styles.qss */

/* Table View Styling */
QTableWidget {
    background-color: #15191E;
    alternate-background-color: #1E232B;
    color: #E2E8F0;
    gridline-color: #2D3139;
    border: 1px solid #2D3139;
    border-radius: 8px;
    selection-background-color: #374151;
}

QHeaderView::section {
    background-color: #0B0E11;
    color: #A0AABF;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #2D3139;
    border-right: 1px solid #2D3139;
    font-weight: bold;
    font-size: 13px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0B0E11;
    width: 12px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #2D3139;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #4B5563;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Dialog and Form elements */
QDialog {
    background-color: #15191E;
}

QDialog QLabel {
    color: #E2E8F0;
    font-weight: bold;
}

QPushButton.DangerAction {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EF4444, stop:1 #DC2626);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton.DangerAction:hover {
    background-color: #B91C1C;
}

QPushButton.LaunchBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10B981, stop:1 #059669);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton.LaunchBtn:hover {
    background-color: #047857;
}

QPushButton.LaunchBtn::menu-indicator {
    image: none;
}

QPushButton.PrimaryAction {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6366F1, stop:1 #4F46E5);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton.PrimaryAction:hover {
    background-color: #4338CA;
}

QPushButton.PrimaryAction::menu-indicator {
    image: none;
}

QPushButton.SecondaryAction {
    background-color: #374151;
    color: #FFFFFF;
    border: 1px solid #4B5563;
    border-radius: 8px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton.SecondaryAction:hover {
    background-color: #4B5563;
}

QPushButton.SecondaryAction::menu-indicator {
    image: none;
}
